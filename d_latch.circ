    <comp lib="12" loc="(200,340)" name="VhdlEntity">
      <a name="content" val="library ieee;&#10;use ieee.std_logic_1164.all;&#10;&#10;entity d_latch is&#10;    port (&#10;        d     : in  std_logic;&#10;        en    : in  std_logic;&#10;        q     : out std_logic;&#10;        q_bar : out std_logic&#10;    );&#10;end entity d_latch;&#10;&#10;architecture behavioral of d_latch is&#10;    signal q_int : std_logic := '0';&#10;begin&#10;    process (d, en)&#10;    begin&#10;        if en = '1' then&#10;            q_int &lt;= d;&#10;        end if;&#10;    end process;&#10;    q     &lt;= q_int;&#10;    q_bar &lt;= not q_int;&#10;end architecture behavioral;"/>
    </comp>
