  </toolbar>
  <circuit name="main">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="main"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <!-- Gate-Level RS Latch using NOR Gates -->
    <comp lib="0" loc="(120,100)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="R"/>
    </comp>
    <comp lib="0" loc="(120,220)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="S"/>
    </comp>
    <comp lib="1" loc="(280,120)" name="NOR Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(280,200)" name="NOR Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="0" loc="(380,120)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Q"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(380,200)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Q_bar"/>
      <a name="output" val="true"/>
    </comp>
    <!-- Wires for Cross-Coupled NOR RS Latch -->
    <wire from="(120,100)" to="(220,100)"/>
    <wire from="(120,220)" to="(220,220)"/>
    <wire from="(280,120)" to="(320,120)"/>
    <wire from="(320,120)" to="(380,120)"/>
    <wire from="(280,200)" to="(340,200)"/>
    <wire from="(340,200)" to="(380,200)"/>
    <wire from="(320,120)" to="(320,160)"/>
    <wire from="(190,160)" to="(320,160)"/>
    <wire from="(190,160)" to="(190,180)"/>
    <wire from="(190,180)" to="(220,180)"/>
    <wire from="(340,150)" to="(340,200)"/>
    <wire from="(200,150)" to="(340,150)"/>
    <wire from="(200,140)" to="(200,150)"/>
    <wire from="(200,140)" to="(220,140)"/>
    <!-- VHDL Entity Instance -->
    <comp lib="0" loc="(120,340)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="r_in"/>
    </comp>
    <comp lib="0" loc="(120,360)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="s_in"/>
    </comp>
    <comp lib="12" loc="(200,340)" name="VhdlEntity">
      <a name="content" val="library ieee;&#10;use ieee.std_logic_1164.all;&#10;&#10;entity rs_latch is&#10;    port (&#10;        r      : in  std_logic;&#10;        s      : in  std_logic;&#10;        q      : out std_logic;&#10;        q_bar  : out std_logic&#10;    );&#10;end entity rs_latch;&#10;&#10;architecture behavioral of rs_latch is&#10;    signal q_int     : std_logic := '0';&#10;    signal q_bar_int : std_logic := '1';&#10;begin&#10;    q_int     &lt;= r nor q_bar_int;&#10;    q_bar_int &lt;= s nor q_int;&#10;    q     &lt;= q_int;&#10;    q_bar &lt;= q_bar_int;&#10;end architecture behavioral;"/>
    </comp>
    <comp lib="0" loc="(380,340)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="q_out"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(380,360)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="q_bar_out"/>
      <a name="output" val="true"/>
    </comp>
    <wire from="(120,340)" to="(200,340)"/>
    <wire from="(120,360)" to="(200,360)"/>
    <wire from="(340,340)" to="(380,340)"/>
    <wire from="(340,360)" to="(380,360)"/>
