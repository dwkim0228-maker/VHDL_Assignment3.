    <comp lib="12" loc="(200,340)" name="VhdlEntity">
      <a name="content" val="library ieee;&#10;use ieee.std_logic_1164.all;&#10;&#10;entity jk_ff is&#10;    port (&#10;        j     : in  std_logic;&#10;        k     : in  std_logic;&#10;        clk   : in  std_logic;&#10;        q     : out std_logic;&#10;        q_bar : out std_logic&#10;    );&#10;end entity jk_ff;&#10;&#10;architecture behavioral of jk_ff is&#10;    signal q_int : std_logic := '0';&#10;begin&#10;    process (clk)&#10;    begin&#10;        if rising_edge(clk) then&#10;            if (j = '0' and k = '0') then&#10;                q_int &lt;= q_int;&#10;            elsif (j = '0' and k = '1') then&#10;                q_int &lt;= '0';&#10;            elsif (j = '1' and k = '0') then&#10;                q_int &lt;= '1';&#10;            elsif (j = '1' and k = '1') then&#10;                q_int &lt;= not q_int;&#10;            end if;&#10;        end if;&#10;    end process;&#10;    q     &lt;= q_int;&#10;    q_bar &lt;= not q_int;&#10;end architecture behavioral;"/>
    </comp>
