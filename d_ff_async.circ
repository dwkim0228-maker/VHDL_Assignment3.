      <a name="content" val="library ieee;&#10;use ieee.std_logic_1164.all;&#10;&#10;entity d_ff_async is&#10;    port (&#10;        d     : in  std_logic;&#10;        clk   : in  std_logic;&#10;        set   : in  std_logic;&#10;        clr   : in  std_logic;&#10;        q     : out std_logic;&#10;        q_bar : out std_logic&#10;    );&#10;end entity d_ff_async;&#10;&#10;architecture behavioral of d_ff_async is&#10;    signal q_int : std_logic := '0';&#10;begin&#10;    process (clk, set, clr)&#10;    begin&#10;        if clr = '1' then&#10;            q_int &lt;= '0';&#10;        elsif set = '1' then&#10;            q_int &lt;= '1';&#10;        elsif rising_edge(clk) then&#10;            q_int &lt;= d;&#10;        end if;&#10;    end process;&#10;    q     &lt;= q_int;&#10;    q_bar &lt;= not q_int;&#10;end architecture behavioral;"/>
